{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "key": "Content-Security-Policy",
        "value": "script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval';"
      }
    ]
  }
}
